# 根目录采用白名单：仅提交网站源码、资源、维护脚本和必要配置
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/astro.config.mjs
!/tsconfig.json
!/wrangler.json
!/worker-configuration.d.ts
!/.env.example
!/.dev.vars.example
!/src/
!/public/
!/scripts/

# 依赖、生成结果和本地缓存（任何目录下均排除）
node_modules/
dist/
.astro/
.wrangler/
.cache/
coverage/
.nyc_output/
*.tsbuildinfo
*.log
*.pid
*.pid.lock

# 环境变量、密钥和证书；只保留无密钥的配置示例
.env*
.dev.vars*
!.env.example
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.mobileprovision

# 本地编辑器、系统文件、备份和临时文件
.vscode/
.idea/
.agents/
.codex/
.aws/
.DS_Store
Thumbs.db
Desktop.ini
*.orig
*.bak
*.tmp
*.temp
*~
